# Copy to .env.local (git-ignored) and fill in.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Dev/test only: enables password sign-in on /signin for automated tests
VITE_ENABLE_PASSWORD_LOGIN=false

# Server-side only (never VITE_-prefixed): used by scripts/ and tests
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
